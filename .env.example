# ==============================================================================
# CHETHAN KUMAR - PORTFOLIO AI ASSISTANT (ZER0) CONFIGURATION
# ==============================================================================
# Instructions: Copy this file to .env.local and populate your API keys.
# .env.local is ignored by Git to protect your credentials.
# Any provider key that is left blank will simply be skipped during rotation.

# 1. Google Gemini (Primary Default)
# https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 2. Groq
# https://console.groq.com/
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# 3. OpenRouter
# https://openrouter.ai/
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# 4. Mistral AI
# https://console.mistral.ai/
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# 5. Cerebras
# https://cloud.cerebras.ai/
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama3.1-8b

# Optional: Hugging Face (OpenAI-compatible router fallback)
HF_TOKEN=
HF_MODEL=meta-llama/Llama-3.2-3B-Instruct

# Optional: Deepgram (for audio or speech pipeline services)
DEEPGRAM_API_KEY=

# Optional: Upstash Redis (for distributed edge rate limiting; falls back to in-memory if empty)
# https://console.upstash.com/
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

